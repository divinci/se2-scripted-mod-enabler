<Project Sdk="Microsoft.NET.Sdk">

  <!-- The assembly name has to match the real one exactly:
       PluginSurfaceTests asserts on the emitted AssemblyRef names. -->

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>VRage.DCS</AssemblyName>
    <RootNamespace>Keen.VRage.DCS</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- The real assembly is unsigned and unversioned in any way we depend on. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

</Project>
