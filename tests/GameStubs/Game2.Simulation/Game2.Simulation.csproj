<Project Sdk="Microsoft.NET.Sdk">

  <!-- The assembly name has to match the real one exactly:
       PluginSurfaceTests asserts on the emitted AssemblyRef names. -->

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>Game2.Simulation</AssemblyName>
    <RootNamespace>Keen.Game2.Simulation</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- The real assembly is unsigned and unversioned in any way we depend on. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../VRage.Library/VRage.Library.csproj" />
  </ItemGroup>

</Project>
